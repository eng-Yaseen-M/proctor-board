# === Frontend (Vite) ===
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# === Server (Vercel Environment Variables) ===
# نفس رابط Supabase
SUPABASE_URL=https://xxxx.supabase.co
# يفضّل Service Role Key من Settings → API (للقراءة والإيميلات)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...

# Resend — من https://resend.com (مجاني)
RESEND_API_KEY=re_xxxxxxxx

# الإيميل المرسل (بعد ما توثّق الدومين في Resend، أو استخدم onboarding@resend.dev للتجربة)
NOTIFY_FROM_EMAIL=onboarding@resend.dev

# رابط موقعك بعد الرفع على Vercel
APP_URL=https://your-app.vercel.app

# سر لحماية الـ API (أي نص عشوائي)
CRON_SECRET=change-me-to-random-string
